# Environment for the real API.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# From BotFather. Required for initData signature verification.
BOT_TOKEN=

# Server-side database access.
FIREBASE_DATABASE_URL=
# Absolute path to the service account JSON (see FIREBASE-SETUP.md part 5).
GOOGLE_APPLICATION_CREDENTIALS=

# Dev only: allow task claims without a real membership check.
ALLOW_TASK_CLAIMS=0

PORT=8800
